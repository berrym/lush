#!/bin/bash
# LLE Development Pre-commit Hook with Documentation Policy Enforcement

echo "Running pre-commit checks..."

CHECKS_FAILED=0

# ============================================================================
# ASCII-ONLY SOURCE ENFORCEMENT
# ============================================================================

echo "Checking staged files for non-ASCII bytes..."
ASCII_RULES="$(git rev-parse --show-toplevel)/scripts/ascii-only.rules"
if [ -f "$ASCII_RULES" ]; then
    ASCII_OFFENDERS=""
    for f in $(git diff --cached --name-only --diff-filter=d); do
        # exempt wins over enforce; both are simple path prefixes
        skip=0
        while read -r kind path; do
            case "$kind" in
                exempt:) case "$f" in $path*) skip=1 ;; esac ;;
            esac
        done < <(grep -E '^(enforce|exempt):' "$ASCII_RULES")
        [ "$skip" = "1" ] && continue

        enforced=0
        while read -r kind path; do
            case "$kind" in
                enforce:) case "$f" in $path*) enforced=1 ;; esac ;;
            esac
        done < <(grep -E '^(enforce|exempt):' "$ASCII_RULES")
        [ "$enforced" = "0" ] && continue

        hits=$(git show ":$f" 2>/dev/null | perl -ne 'printf("%d: %s", $., $_) if /[^\x00-\x7F]/' | head -3)
        if [ -n "$hits" ]; then
            ASCII_OFFENDERS="$ASCII_OFFENDERS\n  $f\n$(printf '%s' "$hits" | sed 's/^/    /')"
        fi
    done

    if [ -n "$ASCII_OFFENDERS" ]; then
        echo "POLICY VIOLATION: non-ASCII bytes in enforced source paths"
        echo ""
        printf '%b\n' "$ASCII_OFFENDERS"
        echo ""
        echo "Source, docs and scripts are ASCII only. Use -- for an em dash,"
        echo "-> for an arrow, and \\xNN escapes when a C literal genuinely"
        echo "needs specific bytes."
        echo ""
        echo "If the file is test DATA whose bytes are the payload (a fuzz"
        echo "corpus, a Unicode parity fixture), add it to scripts/ascii-only.rules"
        echo "as an exempt: entry, with the reason."
        echo ""
        CHECKS_FAILED=1
    else
        echo "OK: staged files are ASCII"
    fi
fi

# ============================================================================
# COMMENT-STYLE + CLANG-FORMAT GATE
# ============================================================================
# Enforces lush's mixed C11/Doxygen comment style and clang-format
# conformance on every staged .c/.h file. See scripts/check_comment_style.sh
# for the rule set. Hard gate -- non-zero exit blocks the commit.

if [ -x scripts/check_comment_style.sh ]; then
    echo "Checking comment-style + clang-format conformance..."
    if ! scripts/check_comment_style.sh --staged; then
        CHECKS_FAILED=1
    fi
fi

# ============================================================================
# TEST EXIT-STATUS INTEGRITY GATE
# ============================================================================
# A test binary that uses RUN_TEST() must return TEST_RESULT() from main, so a
# failing assertion propagates to the process exit code. A bare `return 0`
# makes the suite always-green: it cannot fail in CI regardless of assertions.
# The 2026-06-19 test-quality audit found five core suites (parser, tokenizer,
# symtable, AST node, widget) with exactly this defect.

echo "Checking test exit-status integrity..."
STAGED_TESTS=$(git diff --cached --name-only --diff-filter=d | grep -E '^tests/.*\.c$' || true)
for t in $STAGED_TESTS; do
    [ -f "$t" ] || continue
    if grep -q 'RUN_TEST(' "$t" && ! grep -q 'TEST_RESULT(' "$t"; then
        echo "FAIL TEST INTEGRITY VIOLATION: $t uses RUN_TEST() but never returns TEST_RESULT()"
        echo "   main() must end with 'return TEST_RESULT();' so a failing test reaches"
        echo "   the process exit code; a bare 'return 0' makes the suite always-green."
        echo ""
        CHECKS_FAILED=1
    fi
done

# ============================================================================
# DOCUMENTATION POLICY ENFORCEMENT (SAFE | ORGANIZED | CLEAN | PRUNED)
# ============================================================================

echo "Checking documentation policy compliance..."

# Rule 1: Root Directory Cleanliness
# Check for prohibited files in root
PROHIBITED_IN_ROOT=$(git diff --cached --name-only | grep -E "^[^/]*\.(o|log)$|^core\." || true)
if [ -n "$PROHIBITED_IN_ROOT" ]; then
    echo "FAIL POLICY VIOLATION: Prohibited files in root directory"
    echo "   Build artifacts and logs must not be in root"
    echo "   Files:"
    echo "$PROHIBITED_IN_ROOT"
    echo ""
    CHECKS_FAILED=1
fi

# Check for markdown files in root (excluding allowed files, excluding deletions)
ROOT_MD=$(git diff --cached --name-only --diff-filter=d | grep "^[^/]*\.md$" | grep -v "^README\.md$" || true)
if [ -n "$ROOT_MD" ]; then
    echo "FAIL POLICY VIOLATION: Markdown files must be in docs/ subdirectories"
    echo "   Only README.md allowed in root"
    echo "   Files:"
    echo "$ROOT_MD"
    echo ""
    CHECKS_FAILED=1
fi

# Rule 2: Documentation Structure Warnings
NEW_DOCS=$(git diff --cached --name-only --diff-filter=A | grep "\.md$" || true)
if [ -n "$NEW_DOCS" ]; then
    for doc in $NEW_DOCS; do
        if ! echo "$doc" | grep -qE "^docs/(user|project|development|lle_specification|lle_implementation|archived)/|^docs/DOCUMENTATION_POLICY\.md$|^docs/VISION\.md$|^README\.md$|^CLAUDE\.md$"; then
            echo "WARNING WARNING: New markdown file outside documented structure: $doc"
            echo "   Consider placing in docs/project/ or appropriate subdirectory"
            echo "   See docs/DOCUMENTATION_POLICY.md for structure"
            echo ""
        fi
    done
fi

# Rule 3: Deletion Warning
DELETED_FILES=$(git diff --cached --name-only --diff-filter=D | grep -E "\.(md|c|h)$" || true)
if [ -n "$DELETED_FILES" ]; then
    echo "WARNING Note: File deletions detected"
    echo "   Deleted files:"
    echo "$DELETED_FILES" | head -5
    echo ""
fi

echo "OK Documentation policy checks complete"
echo ""

# ============================================================================
# LLE-SPECIFIC ENFORCEMENT
# ============================================================================

# Check if any LLE files are being committed
LLE_FILES_CHANGED=$(git diff --cached --name-only | grep -E "include/lle/|src/lle/|tests/lle/" || true)

if [ -n "$LLE_FILES_CHANGED" ]; then
    echo "LLE source files detected in commit..."

    # Check for TODO/STUB markers in committed LLE CODE (FORBIDDEN)
    LLE_CODE_FILES=$(git diff --cached --diff-filter=d --name-only | grep -E "include/lle/.*\.(h|c)$|src/lle/.*\.(h|c)$|tests/lle/.*\.(h|c)$" || true)

    if [ -n "$LLE_CODE_FILES" ]; then
        STUB_MARKER_FOUND=""
        STUB_FOUND=""
        SIMPLIFIED_FOUND=""
        DEFERRED_FOUND=""

        for file in $LLE_CODE_FILES; do
            # Check for STUB/FIXME in comments (TODO is allowed)
            if git diff --cached "$file" | grep -E "^\+.*STUB|^\+.*FIXME" > /dev/null; then
                STUB_MARKER_FOUND="yes"
            fi

            # Check for actual stub implementations
            if git diff --cached "$file" | grep -E "^\+.*return LLE_ERROR_FEATURE_NOT_AVAILABLE|^\+.*return LLE_ERROR_NOT_IMPLEMENTED" > /dev/null; then
                STUB_FOUND="yes"
            fi

            # ZERO TOLERANCE: Check for "simplified" language in code/comments
            if git diff --cached "$file" | grep -iE "^\+.*(simplified|simplification)" > /dev/null; then
                SIMPLIFIED_FOUND="yes"
            fi

            # ZERO TOLERANCE: Check for "deferred" language in code/comments
            if git diff --cached "$file" | grep -iE "^\+.*(deferred|defer to later)" > /dev/null; then
                DEFERRED_FOUND="yes"
            fi
        done

        if [ -n "$STUB_MARKER_FOUND" ]; then
            echo "FAIL COMPLIANCE VIOLATION: STUB/FIXME markers found in LLE code"
            echo ""
            echo "FORBIDDEN: LLE code must be complete. No stubs allowed."
            echo "Note: TODO comments are allowed for documenting future enhancements."
            echo ""
            CHECKS_FAILED=1
        fi

        if [ -n "$STUB_FOUND" ]; then
            echo "FAIL COMPLIANCE VIOLATION: Actual stub implementations found in LLE code"
            echo ""
            echo "FORBIDDEN: Functions cannot just return error codes without implementation."
            echo ""
            CHECKS_FAILED=1
        fi

        if [ -n "$SIMPLIFIED_FOUND" ]; then
            echo "FAIL ZERO TOLERANCE VIOLATION: 'Simplified' language found in LLE code"
            echo ""
            echo "FORBIDDEN: Code or comments indicating simplified implementations"
            echo ""
            CHECKS_FAILED=1
        fi

        if [ -n "$DEFERRED_FOUND" ]; then
            echo "FAIL ZERO TOLERANCE VIOLATION: 'Deferred' language found in LLE code"
            echo ""
            echo "FORBIDDEN: Code or comments indicating deferred work"
            echo ""
            CHECKS_FAILED=1
        fi
    fi

    # Check for basic compilation (if build system is available)
    if [ -f "meson.build" ] && [ -d "build" ]; then
        echo "Verifying LLE compilation..."
        if meson compile -C build 2>/dev/null 1>/dev/null; then
            echo "OK LLE files compile successfully"
        else
            echo "WARNING Warning: LLE compilation check failed"
        fi
    fi
fi

# Final result
if [ $CHECKS_FAILED -eq 1 ]; then
    echo ""
    echo "========================================="
    echo "FAIL PRE-COMMIT CHECKS FAILED"
    echo "========================================="
    echo "Fix the violations above before committing."
    echo ""
    exit 1
else
    echo ""
    echo "Pre-commit checks complete OK"
    echo ""
    exit 0
fi
