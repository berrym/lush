[wrap-file]
directory = libhashtable-0.9.0
source_filename = libhashtable-0.9.0.tar.gz
source_url = https://github.com/berrym/libhashtable/releases/download/v0.9.0/libhashtable-0.9.0.tar.gz
source_hash = df9a0a5f18fb48411bcdf9654104915be155dec9675d869e4e9e05bf6a441273

# The release tarball is committed under subprojects/packagecache/. Meson checks
# the cache (hash-verified) before any download, so configuration is hermetic and
# offline; source_url is only a fallback for a fresh checkout missing the cache.
# A published release asset MUST be this exact tarball, produced with:
#   git archive --format=tar --prefix=libhashtable-0.9.0/ v0.9.0 | gzip -n -9
# so the hash matches.

[provide]
dependency_names = libhashtable
